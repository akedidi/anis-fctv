# FCTV iOS — CocoaPods
# Ouvrir le workspace : FCTV.xcworkspace (pas le .xcodeproj seul).
# Mise à jour : `pod install` ou `pod update`

platform :ios, '17.0'
install! 'cocoapods', :warn_for_unused_master_specs_repo => false

target 'FCTV' do
  use_frameworks! :linkage => :static
  # Images distantes (équivalent Glide côté Android).
  pod 'Kingfisher', '~> 8.0'
  # HTTP client (équivalent OkHttp). Décommenter quand vous branchez les APIs réelles.
  pod 'Alamofire', '~> 5.9'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
    end
  end
  # Requis pour que les scripts CocoaPods ([CP] Embed Pods Frameworks) tournent avec Xcode 15+.
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.native_targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      end
    end
  end
end
